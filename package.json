{
  "name": "@alpacachen/dsh-kanban",
  "version": "1.12.0",
  "description": "Human-led Kanban and AI-run workflows for DeepSeek Harness, with native execution, human review and task artifacts.",
  "type": "module",
  "engines": {
    "dsh": "0.2.2-rc.3"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./workflow": "./workflow/index.js",
    "./workflow/locale/*.json": "./workflow/locale/*.json",
    "./workflow/icon": "./image.png",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "search.js",
    "workflow",
    "docs/workflow-model.schema.sql",
    "docs/workflow-validation.md",
    "docs/workflow-guide.md",
    "docs/workflow-guide.en.md",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "image.png",
    "docs/screenshots/card-details-dark.png",
    "docs/testing-images.md",
    "docs/guide.md",
    "docs/guide.zh.md",
    "docs/readme/board-*.png",
    "docs/readme/*.svg",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "check:client-bundle": "node scripts/check-client-bundle.mjs",
    "check:package": "node scripts/check-package-contents.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "check:pipeline": "node scripts/check-pipeline.mjs",
    "test:unit": "vitest run",
    "test": "pnpm test:unit && pnpm check:schema && pnpm check:pipeline",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@xyflow/react": "^12.12.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.3",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-model-selection": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alpacachen/dsh-kanban.git"
  },
  "homepage": "https://github.com/alpacachen/dsh-kanban",
  "bugs": {
    "url": "https://github.com/alpacachen/dsh-kanban/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "kanban",
    "plugin",
    "workflow",
    "ai-agent",
    "human-in-the-loop"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-store"
      ]
    },
    "compatibility": {
      "dsh": "0.2.2-rc.3",
      "dshReleases": {
        "0.2.2-rc.3": "compatible"
      },
      "profiles": [
        "web",
        "desktop"
      ]
    }
  }
}
